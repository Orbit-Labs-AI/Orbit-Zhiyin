    "ascender": 1.0,
    "t_height": 0.8,
    "r_shoulder": 0.42,
    "r_arm_end": 305,
    "i_dot": 1.5,
    "i_dot_gap": 0.1,
    "t_bar": 0.46,
    "spacing": {
      "O_r": 0.2,
      "r_b": 0.11,
      "b_i": 0.13,
      "i_t": 0.08
    }
  },
  "colors": {
    "ink": "#5f6b6f",
    "paper": "#f5f4f0",
    "night_tile": "#000000",
    "night_ink": "#ffffff",
    "black": "#000000",
    "white": "#ffffff"
