{
  "name": "Orbit mark",
  "version": 2,
  "note": "Orbit 标志与全部图标素材的唯一参数来源。改动任何数值都会改变标志，须经 yhyfhgs 确认；改后运行 python3 docs/design/logo/generate.py 与 node docs/design/logo/export.mjs。说明见 docs/design/brand.md#绘制参数。",
  "curve": {
    "type": "conical-spiral",
    "turns": 1.6,
    "r_start": 9.0,
    "r_end": 16.0,
    "rise": 14.0,
    "phase": 0.6,
    "samples": 3000
  },
  "view": {
    "projection": "orthographic",
    "yaw": 20,
    "pitch": 45
  },
  "design": {
    "size": 512,
    "pad": 48,
    "resample": 1.5,
    "box_pad": 4
  },
  "stroke": {
    "w_far": 4.0,
    "w_near": 14.0,
    "taper": 0.1,
    "w_floor": 0.6,
    "gap": 24.0,
    "cap": "round"
  },
  "vector": {
    "tolerance": 0.002,
    "digits": 3
  },
  "tile": {
    "size": 1024,
    "radius": 230,
    "mark": 0.68
  },
  "dock": {
    "canvas": 1024,
    "tile": 824,
    "shadow": {
      "dy": 10,
      "blur": 10,
      "opacity": 0.3
    }
  },
  "wordmark": {
    "note": "全名 Orbit·知音。O 为同一螺旋在 o_pitch 视角下的投影；rbit、间隔点（中文「·」）与知音取自开源字体（OFL），只做等比缩放与排列。长度以字高 H（O 墨迹高度减去上下溢出）为单位",
    "o_pitch": 75,
    "overshoot": 0.015,
    "glyphs": "wordmark-glyphs.json",
    "fonts": {
      "latin": {
        "family": "Josefin Sans",
        "weight": 400,
        "source": "https://raw.githubusercontent.com/google/fonts/main/ofl/josefinsans/JosefinSans%5Bwght%5D.ttf"
      },
      "cjk": {
        "family": "Noto Sans SC",
        "weight": 350,
        "source": "https://raw.githubusercontent.com/google/fonts/main/ofl/notosanssc/NotoSansSC%5Bwght%5D.ttf"
      }
    },
    "ascender": 1.0,
    "tracking": 0.0,
    "spacing": {
      "O_r": 0.16,
      "t_dot": 0.3,
      "dot_cjk": 0.3
    },
    "cjk": {
      "height": 0.86,
      "note": "知音墨迹高度 = H × height，垂直中心在字高中线"
    },
    "dot": {
      "height": 0.38,
      "note": "中文间隔点取 cjk 字体的「·」字形，与知音同比例缩放；圆心在基线上方 height × H"
    }
  },
  "motion": {
    "note": "点击标志：视角 pitch 由 view.pitch 转到 wordmark.o_pitch，同时移到字标 O 的位置，随后 rbit 依次出现；再点击按相反顺序收回",
    "frames": 49,
    "tolerance": 0.05,
    "digits": 1,
    "turn_ms": 900,
    "letter_delay_ms": 110,
    "letter_ms": 420
  },
  "colors": {
    "ink": "#5f6b6f",
    "paper": "#f5f4f0",
    "night_tile": "#000000",
    "night_ink": "#ffffff",
    "black": "#000000",
    "white": "#ffffff",
    "night_word": "#d6c7a1"
  }
}
