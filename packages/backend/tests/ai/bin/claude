#!/usr/bin/env python3
"""Fake `claude` CLI for tests: logs argv/stdin/cwd/env to $FAKE_LOG, acts per $FAKE_MODE."""

import json
import os
import sys
import time

HELP = """Usage: claude [options] [command] [prompt]
  -p, --print                 Print response and exit
  --output-format <format>    text | json | stream-json
  --json-schema <schema>      JSON Schema for structured output
  --system-prompt <prompt>    System prompt
  --tools <tools...>          Available tools
  --no-session-persistence    Do not save the session
  --safe-mode                 Disable user customizations
  --strict-mcp-config         Only use MCP servers from --mcp-config
  --max-budget-usd <amount>   Spend cap
  --model <model>             Model alias or id
  --effort <level>            Reasoning effort
  --settings <file-or-json>   Extra settings
"""
mode = os.environ.get("FAKE_MODE", "ok")
args = sys.argv[1:]
if args == ["--version"]:
    print("2.1.287 (Claude Code)")
elif args == ["--help"]:
    print(HELP)
elif args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": mode != "notlogged"}))
else:
    stdin = sys.stdin.read()
    with open(os.environ["FAKE_LOG"], "a", encoding="utf-8") as log:
        log.write(json.dumps({"argv": sys.argv, "stdin": stdin, "cwd": os.getcwd(),
                              "env": dict(os.environ)}) + "\n")
    if mode == "sleep":
        time.sleep(30)
    usage = {"input_tokens": 120, "cache_read_input_tokens": 30,
             "cache_creation_input_tokens": 10, "output_tokens": 40}
    base = {"type": "result", "usage": usage, "total_cost_usd": 0.0123,
            "modelUsage": {"claude-sonnet-5-5": {"inputTokens": 120}}}
    if mode == "budget":
        print(json.dumps({**base, "subtype": "error_max_budget_usd", "is_error": True,
                          "result": ""}))
        sys.exit(1)
    if mode == "notlogged":
        print(json.dumps({**base, "subtype": "success", "is_error": True,
                          "result": "Invalid API key · Please run /login"}))
        sys.exit(1)
    print(json.dumps({**base, "subtype": "success", "is_error": False,
                      "result": json.dumps({"answer": "ok"}),
                      "structured_output": {"answer": "ok"}}))
