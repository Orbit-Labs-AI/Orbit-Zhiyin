      "cost": {"setup_minutes": 5, "context_tokens": 600},
      "track": {"triggered": "同参数重复失败", "mechanical": "Skill 调用次数", "guardrail": "测试通过率"},
      "explain": {"reason_template": "{k} 个会话里出现反复失败或修复后仍出错。",
                  "mechanism": "排错方法类问题用 skill 固化流程。",
                  "trial": "下次出错时说「按系统化排错处理」，对比首次有效验证前的调用数。",
                  "limitation": "提供流程，不强制计数；需配合熔断 hook。"},
