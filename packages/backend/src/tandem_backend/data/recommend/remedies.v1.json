      "cost": {"setup_minutes": 1},
      "risk": {"level": "medium", "flags": ["broader_permissions"]},
      "track": {"triggered": "审批次数", "mechanical": "使用内置模式的会话数", "guardrail": "非预期写入次数"},
      "explain": {"reason_template": "{k} 个会话里频繁出现审批等待。",
                  "mechanism": "不想写规则文件时，先用 Agent 内置的权限模式。",
                  "trial": "下一个会话开启内置模式，观察审批次数。",
                  "limitation": "放行范围比白名单宽，敏感仓库慎用。"},
      "tags": ["permission", "approval", "builtin"],
      "steps": ["在会话中切换到内置的宽松权限模式", "只在可信仓库使用", "7 天后对比审批次数"]
    },
    {
      "id": "retry-breaker", "title": "重复失败熔断：同一命令失败 2 次先诊断",
      "summary": "同一命令连续失败两次后暂停，先检查认证与环境再继续。",
      "problem": {"types": ["tool_env_failure"]},
      "remedy": {"kind": "hook", "dim": "hook", "agents": {"claude_code": "native", "codex": "adaptation_required"}, "level": 2,
