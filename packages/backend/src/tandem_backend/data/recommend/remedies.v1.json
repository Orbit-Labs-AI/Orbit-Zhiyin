{
  "schema_version": "remedies-v1",
  "origin": "Tandem template library (written and reviewed in this repository; no third-party text)",
  "rules": [
    {
      "id": "readonly-allowlist", "title": "只读命令自动放行",
      "summary": "把 git status、ls、gh pr view 等只读命令加入权限白名单，不再逐次审批。",
      "problem": {"types": ["permission_friction"], "key_prefix": "would_prompt:readonly_shell"},
      "remedy": {"kind": "permission_rule", "dim": "hook", "agents": {"claude_code": "native", "codex": "manual"}, "level": 1,
                 "template": "permission-allow@1", "alternatives": ["fewer-permission-prompts"]},
      "benefit": {"unit": "次审批", "unit_minutes": 0.5, "prior": {"alpha": 9, "beta": 1}},
      "cost": {"setup_minutes": 1, "context_tokens": 0, "reversible": true},
      "risk": {"level": "low", "flags": ["writes_settings"]},
      "track": {"triggered": "只读命令审批次数", "mechanical": "白名单命中次数", "guardrail": "误放行的写命令次数"},
      "explain": {"reason_template": "{k} 个会话里你手动批准了约 {weekly} 次/周只读命令（{heads}）。",
                  "mechanism": "权限摩擦优先用权限规则解决：只放行只读命令，写命令照常审批。",
                  "trial": "新开会话运行 git status，确认不再弹出审批；7 天后看审批次数。",
                  "limitation": "只覆盖列出的命令前缀；带管道或重定向的命令仍会审批。"},
      "tags": ["permission", "approval", "readonly", "bash", "git", "settings"],
      "file": [["{", " "], ["  \"permissions\": {", " "], ["    \"allow\": [", " "], ["      \"Bash(git status:*)\",", "+"],
               ["      \"Bash(git diff:*)\",", "+"], ["      \"Bash(git log:*)\",", "+"], ["      \"Bash(ls:*)\",", "+"], ["    ]", " "], ["  }", " "], ["}", " "]],
      "steps": ["预览将写入 settings.json 的放行规则", "确认写入（会先备份原文件）", "新开会话运行 git status，确认不再弹出审批", "7 天后在效果追踪里看审批次数变化"]
    },
    {
      "id": "fewer-permission-prompts", "title": "用 Agent 自带的权限模式减少审批",
      "summary": "在 Claude Code 中切换到 acceptEdits 等内置权限模式，或用自带的审批记忆。",
      "problem": {"types": ["permission_friction"]},
      "remedy": {"kind": "builtin", "dim": "hook", "agents": {"claude_code": "native", "codex": "native"}, "level": 1,
                 "alternatives": ["readonly-allowlist"]},
