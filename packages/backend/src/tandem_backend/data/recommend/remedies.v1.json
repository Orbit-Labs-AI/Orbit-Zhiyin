      "benefit": {"unit": "段重复失败", "unit_minutes": 2, "prior": {"alpha": 8, "beta": 2}},
      "cost": {"setup_minutes": 3, "reversible": true},
      "risk": {"level": "low", "flags": ["runs_script"]},
      "track": {"triggered": "重复失败序列", "mechanical": "熔断触发次数", "guardrail": "任务完成率"},
      "explain": {"reason_template": "{k} 个会话出现「失败后原样重试」，约 {weekly} 次/周。",
                  "mechanism": "工具/环境失败优先用 hook 在执行层拦截，比提示词更可靠。",
                  "trial": "下次连续失败时，确认 Agent 先停下来检查环境。",
                  "limitation": "只拦截完全相同的命令；参数变化的重试不计入。"},
      "tags": ["retry", "failure", "hook", "bash", "debugging"],
      "file": [["{", " "], ["  \"hooks\": {", "+"], ["    \"PostToolUse\": [{", "+"], ["      \"matcher\": \"Bash\",", "+"],
               ["      \"hooks\": [{ \"type\": \"command\", \"command\": \"~/.tandem/hooks/retry-breaker.sh\" }]", "ai"], ["    }]", "+"], ["  }", "+"], ["}", " "]],
      "steps": ["预览将写入的 Hook 与脚本", "确认安装（脚本放在 ~/.tandem/hooks，可随时删除）", "下次连续失败时 Agent 会先检查认证与环境"]
    },
